# Neon -> Dashboard -> Connection Details -> "Connection string" (Pooled)
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Comma-separated list of allowed browser origins. Use your Vercel URL.
# "*" is fine while you are still wiring things up.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:8731
